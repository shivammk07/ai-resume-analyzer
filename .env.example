# Optional Gemini AI Enrichment (Deterministic local ATS engine works with zero API key)
GEMINI_API_KEY=

# Relational Database Configuration (Java JDBC / MySQL 8)
# Leave blank to automatically use embedded H2 in-memory MySQL-compatibility mode
DB_URL=jdbc:mysql://localhost:3306/careerpulse?useSSL=true&serverTimezone=UTC
DB_USER=
DB_PASSWORD=

# Application URL (Optional)
APP_URL=http://localhost:3000
